  <metadata>
    <id>pithflow</id>
    <version>1.47.0</version>
    <title>Pithflow</title>
    <authors>Pithflow</authors>
    <owners>pithflow</owners>
    <projectUrl>https://pithflow.com/</projectUrl>
    <packageSourceUrl>https://github.com/0bad-dragon0/pithflow-chocolatey</packageSourceUrl>
    <iconUrl>https://pithflow.com/favicon.png</iconUrl>
    <licenseUrl>https://pithflow.com/terms/</licenseUrl>
